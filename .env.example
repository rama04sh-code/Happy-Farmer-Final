# Development settings
# Generate a random key using: openssl rand -hex 32

DATABASE_URL=postgresql+psycopg2://happy:CHANGE_ME@db:5432/happyfarmer
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=1440

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,backend
FORCE_HTTPS=false

POSTGRES_USER=happy
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=happyfarmer

# Host PostgreSQL port. Inside Docker, PostgreSQL uses port 5432.
POSTGRES_PORT=5433

# For running Backend directly outside Docker, use localhost:5433 instead:
# DATABASE_URL=postgresql+psycopg2://happy:CHANGE_ME@localhost:5433/happyfarmer

LOGIN_MAX_ATTEMPTS=8
LOGIN_IP_MAX_ATTEMPTS=40
LOGIN_WINDOW_MINUTES=15

FORWARDED_ALLOW_IPS=127.0.0.1

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

DIAGNOSIS_MIN_CONFIDENCE=0.6
DIAGNOSIS_DEMO_MODE=false

BACKUP_DIR=backups
BACKUP_KEEP_DAYS=30

# Configure SMTP for actual password reset delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true